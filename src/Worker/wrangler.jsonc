{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "actanex-demo-worker",
  "main": "src/index.ts",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": ["nodejs_compat"],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "actanex-demo-db",
      "database_id": "10266018-946e-441a-a9b2-9345b70c661d"
    }
  ],

  "r2_buckets": [
    {
      "binding": "STORAGE",
      "bucket_name": "actanex-demo-storage"
    }
  ],

  "vars": {
    "APP_NAME": "ActaNex Demo Showcase",
    "APP_VERSION": "3.0.0",
    "IS_DEMO_ENVIRONMENT": "true",
    "GITHUB_REPO_OWNER": "MKN1411",
    "GITHUB_REPO_NAME": "actanex-demo"
  },

  "ai": {
    "binding": "AI"
  },

  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}
